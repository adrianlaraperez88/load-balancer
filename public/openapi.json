{
  "openapi": "3.0.3",
  "info": {
    "title": "ISG Enterprise Load Balancer & Gateway API",
    "version": "1.0.0",
    "description": "Zero-trust reverse proxy, load balancer, and cluster management API built on Laravel 12/13 and PHP 8.3. Supports dynamic node routing, HMAC-SHA256 request signing, and Laravel Sanctum token security."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Gateway (Docker / Windows IIS)"
    }
  ],
  "components": {
    "securitySchemes": {
      "SanctumBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum Token",
        "description": "Personal Access Token returned by /api/auth/login"
      },
      "MetricsSecretAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Metrics-Secret",
        "description": "Optional administrative secret token for metrics endpoints"
      },
      "HmacSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-LB-Signature",
        "description": "HMAC-SHA256 signature generated by app03 gateway using shared secret"
      },
      "HmacTimestamp": {
        "type": "apiKey",
        "in": "header",
        "name": "X-LB-Timestamp",
        "description": "Unix timestamp in seconds when the request was signed"
      },
      "RequestId": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Request-Id",
        "description": "Unique UUID v4 request identifier used as cryptographic nonce and distributed tracing ID"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Alice Smith" },
          "email": { "type": "string", "format": "email", "example": "alice@enterprise.com" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "UpstreamNode": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "backend_app01" },
          "url": { "type": "string", "format": "uri", "example": "http://backend_app01:8000" },
          "weight": { "type": "integer", "example": 10 },
          "is_active": { "type": "boolean", "example": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "IpRule": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "ip_address": { "type": "string", "example": "192.168.1.100" },
          "action": { "type": "string", "enum": ["allow", "block", "route"], "example": "route" },
          "target_node_id": { "type": "integer", "nullable": true, "example": 2 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Unauthorized" },
          "message": { "type": "string", "example": "Invalid credentials provided." }
        }
      }
    }
  },
  "paths": {
    "/up": {
      "get": {
        "summary": "Health Check Probe",
        "description": "Liveness/readiness probe for Nginx, PHP-FPM, Docker, and Kubernetes.",
        "responses": {
          "200": {
            "description": "Application is healthy",
            "content": {
              "text/html": {
                "schema": { "type": "string", "example": "Application is healthy" }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Sanctum User Login",
        "description": "Authenticates user credentials and issues a plaintext Sanctum Bearer access token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "alice@enterprise.com" },
                  "password": { "type": "string", "format": "password", "example": "SecretPass123!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": { "type": "string", "example": "1|abc123xyzTokenValue..." },
                    "token_type": { "type": "string", "example": "Bearer" },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Get Authenticated User Profile",
        "description": "Returns profile information for the token-authenticated caller.",
        "security": [{ "SanctumBearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated user object",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": {
            "description": "Unauthenticated / Invalid Bearer token"
          }
        }
      }
    },
    "/api/auth/workload": {
      "post": {
        "summary": "Execute Secure Workload",
        "description": "Dispatches a protected workload that requires valid Sanctum Bearer authentication.",
        "security": [{ "SanctumBearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task": { "type": "string", "example": "process_orders" },
                  "batch_id": { "type": "integer", "example": 1054 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Workload processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "user_id": { "type": "integer", "example": 1 },
                    "data": { "type": "object" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Sanctum Logout",
        "description": "Revokes the currently active Sanctum access token.",
        "security": [{ "SanctumBearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Token revoked successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Token revoked successfully" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/load-balancer/nodes": {
      "get": {
        "summary": "List Upstream Cluster Nodes",
        "description": "Returns all configured backend processing nodes in the load balancer cluster.",
        "security": [{ "MetricsSecretAuth": [] }],
        "responses": {
          "200": {
            "description": "List of upstream nodes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/UpstreamNode" }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Register New Upstream Node",
        "description": "Adds a new backend processing server to the cluster. Instantly invalidates node cache.",
        "security": [{ "MetricsSecretAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "url"],
                "properties": {
                  "name": { "type": "string", "example": "backend_app06" },
                  "url": { "type": "string", "format": "uri", "example": "http://10.0.0.16:8000" },
                  "weight": { "type": "integer", "default": 1, "example": 5 },
                  "is_active": { "type": "boolean", "default": true, "example": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Node created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UpstreamNode" }
              }
            }
          }
        }
      }
    },
    "/api/load-balancer/nodes/{id}": {
      "get": {
        "summary": "Get Upstream Node Details",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "security": [{ "MetricsSecretAuth": [] }],
        "responses": {
          "200": {
            "description": "Upstream node details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UpstreamNode" }
              }
            }
          },
          "404": { "description": "Node not found" }
        }
      },
      "delete": {
        "summary": "Delete Upstream Node",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "security": [{ "MetricsSecretAuth": [] }],
        "responses": {
          "200": {
            "description": "Node removed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Node deleted successfully" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/load-balancer/nodes/{id}/toggle": {
      "patch": {
        "summary": "Toggle Node Active/Inactive State",
        "description": "Drains or re-activates traffic routing to this node without deleting it.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "security": [{ "MetricsSecretAuth": [] }],
        "responses": {
          "200": {
            "description": "Updated node status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UpstreamNode" }
              }
            }
          }
        }
      }
    },
    "/api/load-balancer/ip-rules": {
      "get": {
        "summary": "List IP Affinity & Firewall Rules",
        "security": [{ "MetricsSecretAuth": [] }],
        "responses": {
          "200": {
            "description": "List of IP rules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/IpRule" }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create IP Affinity / Block Rule",
        "security": [{ "MetricsSecretAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ip_address", "action"],
                "properties": {
                  "ip_address": { "type": "string", "example": "192.168.1.100" },
                  "action": { "type": "string", "enum": ["allow", "block", "route"], "example": "route" },
                  "target_node_id": { "type": "integer", "example": 2 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "IP Rule created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IpRule" }
              }
            }
          }
        }
      }
    },
    "/api/load-balancer/metrics": {
      "get": {
        "summary": "Cluster Observability Metrics",
        "description": "Provides real-time aggregated metrics: requests per node, HTTP status code distributions, and average latency.",
        "security": [{ "MetricsSecretAuth": [] }],
        "responses": {
          "200": {
            "description": "Cluster metrics summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total_requests": { "type": "integer", "example": 4700 },
                    "nodes": { "type": "object" },
                    "status_codes": { "type": "object" },
                    "avg_response_time_ms": { "type": "number", "example": 182.5 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
