APP_NAME="LoadBalancerGateway"
APP_ENV=production
APP_KEY=base64:u3G5jEHzkH7P7M4N1w8xYz9vB2cQ5sT8u1vW4xY7z0A=
APP_DEBUG=false
APP_URL=https://app03.yourdomain.com

LOG_CHANNEL=daily
LOG_LEVEL=info

# Database Configuration (MSSQL by default, or mysql/sqlite)
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=load_balancer
DB_USERNAME=sa
DB_PASSWORD=YourStrongPasswordHere!
DB_TRUST_SERVER_CERTIFICATE=true

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ------------------------------------------------------------------------------
# Load Balancer & Reverse Proxy Engine (app03 Front Gateway)
# ------------------------------------------------------------------------------
LOAD_BALANCER_MODE=proxy
LOAD_BALANCER_DEFAULT_STRATEGY=round_robin
LOAD_BALANCER_TIMEOUT=60
LOAD_BALANCER_CONNECT_TIMEOUT=5
LOAD_BALANCER_TLS_VERIFY=true
LOAD_BALANCER_FORCE_HTTPS=false
LOAD_BALANCER_STICKY_SESSIONS=false
LOAD_BALANCER_STREAM_RESPONSES=true
LOAD_BALANCER_MAX_BODY_SIZE=10485760

# Telemetry & Sampling
LOAD_BALANCER_LOGGING=true
LOAD_BALANCER_SAMPLE_RATE=1.0

# Circuit Breaker & Fail-Open Resilience
LOAD_BALANCER_CIRCUIT_BREAKER_ENABLED=true
LOAD_BALANCER_CIRCUIT_BREAKER_FAIL_RATE=0.5
LOAD_BALANCER_CIRCUIT_BREAKER_MIN_REQ=5
LOAD_BALANCER_CIRCUIT_BREAKER_DECAY=30

# Zero-Trust HMAC Request Signing
LOAD_BALANCER_SIGN_REQUESTS=false
LOAD_BALANCER_HMAC_SECRET=your-64-byte-shared-secret-key-here

# Web Application Firewall
LOAD_BALANCER_WAF_ENABLED=true
LOAD_BALANCER_WAF_LIMIT=500

# Protected Observability Metrics Endpoint
LOAD_BALANCER_METRICS_ENABLED=false
LOAD_BALANCER_METRICS_TOKEN=
LOAD_BALANCER_METRICS_IP_ALLOWLIST=
