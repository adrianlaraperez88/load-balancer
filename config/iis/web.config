<?xml version="1.0" encoding="UTF-8"?>
<!-- ISG Load Balancer: Production IIS Configuration for app03 Front Gateway -->
<configuration>
    <system.webServer>
        
        <!-- 1. URL Rewrite: Enrutamiento correcto para Laravel -->
        <rewrite>
            <rules>
                <!-- Corrección: Pasa el encabezado Authorization a PHP en lugar de bloquearlo -->
                <rule name="Import Laravel Authorization Header" stopProcessing="false">
                    <match url=".*" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{HTTP_AUTHORIZATION}" pattern="(.+)" />
                    </conditions>
                    <serverVariables>
                        <set name="HTTP_AUTHORIZATION" value="{C:1}" />
                    </serverVariables>
                </rule>
                
                <!-- Regla estándar de Laravel: Redirige a index.php si el archivo/carpeta no existe -->
                <rule name="Laravel Standard Rewrite" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>

        <!-- 2. Request Filtering: Seguridad de archivos y límites de carga -->
        <security>
            <requestFiltering>
                <!-- Límite de 10 MB para cargas (Coincide con LOAD_BALANCER_MAX_BODY_BYTES) -->
                <requestLimits maxAllowedContentLength="10485760" />
                <hiddenSegments>
                    <add segment=".env" />
                    <add segment="web.config" />
                    <add segment="composer.json" />
                    <add segment="composer.lock" />
                    <add segment="storage" />
                    <add segment="resources" />
                </hiddenSegments>
            </requestFiltering>
        </security>

        <!-- 3. Encabezados de Seguridad -->
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-XSS-Protection" value="1; mode=block" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
            </customHeaders>
        </httpProtocol>

        <!-- 4. Documento por Defecto -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>
        
    </system.webServer>
</configuration>