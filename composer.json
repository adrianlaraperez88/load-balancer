{
    "name": "adrianlaraperez88/load-balancer",
    "description": "Enterprise Load Balancer and Reverse Proxy Gateway for Laravel",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/promises": "^2.0",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Isg\\LoadBalancer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Isg\\LoadBalancer\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Isg\\LoadBalancer\\LoadBalancerServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
